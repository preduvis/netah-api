PORT=8081
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
FRONTEND_URL=http://localhost:8080
NODE_ENV=development
JWT_SECRET=your-secret-key-here

# Email Service (Brevo)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-email@example.com
BREVO_FROM_NAME=Netah

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# Admin Seeder (for initial admin user creation)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE=+2348000000000
